{
  "schema_version": 1,
  "profile": "document-vqa-environment-smoke",
  "model_path": "models/qwen3-vl-2b-instruct",
  "dataset_path": "data/raw/docvqa-smoke",
  "device": "cuda:0",
  "dtype": "bfloat16",
  "attention_backend": "sdpa",
  "cpu_threads": 2,
  "processor": {
    "spatial_factor": 32,
    "min_image_tokens": 128,
    "max_image_tokens": 768,
    "min_pixels": 131072,
    "max_pixels": 786432,
    "padding_side": "left",
    "max_input_tokens": 2048
  },
  "generation": {
    "do_sample": false,
    "max_new_tokens": 64,
    "use_cache": true
  },
  "smoke": {
    "batch_sizes": [1, 2],
    "reserved_gpu_margin_mib": 768,
    "prompt_suffix": "Answer with only the short answer, without explanation.",
    "feature_atol": 0.0,
    "feature_rtol": 0.0,
    "logit_atol": 0.02,
    "logit_rtol": 0.001
  },
  "note": "Environment starting configuration; no performance-optimality or dataset accuracy claim."
}
